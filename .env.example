GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here
MAPBOX_ACCESS_TOKEN=pk.your_public_mapbox_token_here
FLASK_DEBUG=false
PORT=5000
# OpenWeatherMap key for weather planning (https://openweathermap.org/api, free plan works).
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# OpenAI key for Commute mode (jeepney, bus and LRT/MRT routes found with web search).
OPENAI_API_KEY=your_openai_api_key_here
# Optional: model to use and the most commute searches per day (protects your OpenAI bill).
OPENAI_MODEL=gpt-5.4-mini
COMMUTE_DAILY_LIMIT=200
# MapQuest key for the MapQuest trip panel. Get one at https://developer.mapquest.com/
MAPQUEST_API_KEY=your_mapquest_api_key_here
# Webex Teams: a trip summary is posted automatically for each new search to this room.
# Personal access token: https://developer.webex.com/docs/getting-started (expires after 12 hours)
WEBEX_ACCESS_TOKEN=your_webex_access_token_here
# Room id: list your rooms with GET https://webexapis.com/v1/rooms
WEBEX_ROOM_ID=your_webex_room_id_here
