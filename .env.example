GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here
MAPBOX_ACCESS_TOKEN=pk.your_public_mapbox_token_here
FLASK_DEBUG=false
PORT=5000
# OpenWeatherMap key for weather planning (https://openweathermap.org/api, free plan works).

# Google Maps Platform key for public transport routes. Enable the "Routes API" and billing
# on the Google Cloud project (https://developers.google.com/maps/documentation/routes).
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
