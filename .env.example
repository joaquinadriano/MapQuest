GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here
MAPBOX_ACCESS_TOKEN=pk.your_public_mapbox_token_here
FLASK_DEBUG=false
PORT=5000
# OpenWeatherMap key for weather planning (https://openweathermap.org/api, free plan works).
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# OpenAI key for Commute mode (jeepney, bus and LRT/MRT routes found with web search).
OPENAI_API_KEY=your_openai_api_key_here
# Optional: model to use and the most commute searches per day (protects your OpenAI bill).
OPENAI_MODEL=gpt-5.4-mini
COMMUTE_DAILY_LIMIT=200
